{
  "name": "@chaocw/playwright-http-reporter",
  "version": "0.1.0",
  "description": "Playwright reporter that POSTs test events to an HTTP endpoint.",
  "keywords": [
    "playwright",
    "playwright-reporter",
    "reporter",
    "http",
    "ci"
  ],
  "license": "MIT",
  "author": "chaocw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaocwu/playwright-http-reporter.git"
  },
  "homepage": "https://github.com/chaocwu/playwright-http-reporter#readme",
  "bugs": {
    "url": "https://github.com/chaocwu/playwright-http-reporter/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/types.mjs && bun build src/index.ts --outfile dist/index.mjs --format esm --target node && bun build src/index.ts --outfile dist/index.cjs --format cjs --target node",
    "typecheck": "bun check src tests example",
    "lint": "bun lint --no-script --max-warnings=0",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "test": "bun test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.42.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
